    {
      "id": "freeciv",
      "title": "Freeciv",
      "shelf": "build",
      "icon": "🗺️",
      "kind": "native",
      "modes": ["solo", "host", "join", "family"],
      "exe": "apps/windows/freeciv/freeciv-gtk3.22.exe",
      "args_by_mode": {
        "solo": ["--autoconnect", "--server", "127.0.0.1", "--port", "5556"],
        "host": ["--autoconnect", "--server", "127.0.0.1", "--port", "5556"],
        "join": ["--autoconnect", "--server", "{join}", "--port", "5556"],
        "family": ["--autoconnect", "--server", "{hub}", "--port", "5556"]
      },
      "local_server": {
        "exe": "apps/windows/freeciv/freeciv-server.exe",
        "port": 5556,
        "args_by_mode": {
          "solo": ["--bind", "127.0.0.1", "--port", "5556", "--saves", "{saves}/freeciv", "--quitidle", "120", "--read", "{root}/catalog/freeciv-local.serv"],
          "host": ["--bind", "0.0.0.0", "--port", "5556", "--saves", "{saves}/freeciv", "--quitidle", "120", "--read", "{root}/catalog/freeciv-host.serv"]
        }
      },
      "mode_labels": {
        "solo": "Play",
        "host": "Host",
        "join": "Join a friend",
        "family": "Family game"
      }
    },
    {
      "id": "mindustry",
      "title": "Mindustry",
      "shelf": "build",
      "icon": "🏭",
      "kind": "native",
      "modes": ["solo", "family"],
      "exe": "apps/windows/jre/bin/java.exe",
      "args": [
        "-Xms256M",
        "-Xmx1G",
        "-jar",
        "{root}/apps/windows/mindustry/Mindustry.jar"
      ],
      "args_by_mode": {
        "family": [
          "-Xms256M",
          "-Xmx1G",
          "-Darcade.join={hub}:6567",
          "-Darcade.name={player}",
          "-jar",
          "{root}/apps/windows/mindustry/Mindustry.jar"
        ]
      },
      "install": [
        {
          "from": "catalog/mindustry/arcade-autojoin",
          "to": "{saves}/mindustry/mods/arcade-autojoin"
        }
      ],
      "env": {
        "MINDUSTRY_DATA_DIR": "{saves}/mindustry/"
      },
      "mode_labels": {
        "solo": "Play",
        "family": "Family game"
      }
    }
  ]
