input_player3_stk_r_x- = "17"
input_player3_stk_r_y+ = "18"
input_player3_stk_r_y- = "19"
input_player3_btn_r2 = "12"
input_player3_btn_l2 = "11"
input_libretro_device_p3 = "1"
input_player3_analog_dpad_mode = "0"
input_remap_port_p3 = "2"
