# GoldenEye 007 on an Xbox-layout pad. Pair with in-game Control Style 1.2 Solitaire.
# Keys are the physical RetroPad input, values the RetroPad input the core sees
# (0-15 buttons, 16-23 analog half-axes: l_x+ l_x- l_y+ l_y- r_x+ r_x- r_y+ r_y-).
# install.ps1 copies this into RetroArch's config\remaps\Mupen64Plus-Next\ once
# per ROM filename in catalog/games.json, since RetroArch matches on filename.
#
# Sticks swapped: left stick drives the C-buttons (move/strafe under Solitaire),
# right stick drives the N64 stick (turn/look).
# RT fires (N64 Z, which the core reads from L2); LT aims (N64 R); RB still aims.
# Same for all four ports, so a second pad on one PC plays the same way.
input_player1_stk_l_x+ = "20"
input_player1_stk_l_x- = "21"
input_player1_stk_l_y+ = "22"
input_player1_stk_l_y- = "23"
input_player1_stk_r_x+ = "16"
input_player1_stk_r_x- = "17"
input_player1_stk_r_y+ = "18"
input_player1_stk_r_y- = "19"
input_player1_btn_r2 = "12"
input_player1_btn_l2 = "11"
input_libretro_device_p1 = "1"
input_player1_analog_dpad_mode = "0"
input_remap_port_p1 = "0"
input_player2_stk_l_x+ = "20"
input_player2_stk_l_x- = "21"
input_player2_stk_l_y+ = "22"
input_player2_stk_l_y- = "23"
input_player2_stk_r_x+ = "16"
input_player2_stk_r_x- = "17"
input_player2_stk_r_y+ = "18"
input_player2_stk_r_y- = "19"
input_player2_btn_r2 = "12"
input_player2_btn_l2 = "11"
input_libretro_device_p2 = "1"
input_player2_analog_dpad_mode = "0"
input_remap_port_p2 = "1"
input_player3_stk_l_x+ = "20"
input_player3_stk_l_x- = "21"
input_player3_stk_l_y+ = "22"
input_player3_stk_l_y- = "23"
